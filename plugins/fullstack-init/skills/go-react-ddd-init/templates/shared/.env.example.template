# 服务器配置
PORT=8080

# 数据库配置
DB_DRIVER={{DATABASE}}
DB_HOST=localhost
DB_PORT={{#if DATABASE_POSTGRES}}5432{{/if}}{{#if DATABASE_MYSQL}}3306{{/if}}
DB_USER={{#if DATABASE_POSTGRES}}postgres{{/if}}{{#if DATABASE_MYSQL}}mysql{{/if}}
DB_PASSWORD={{#if DATABASE_POSTGRES}}postgres{{/if}}{{#if DATABASE_MYSQL}}mysql{{/if}}
DB_NAME={{PROJECT_NAME}}

{{#if ENABLE_AUTH}}
# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=24h
{{/if}}

# CORS 配置
CORS_ORIGINS=http://localhost:5173

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 环境
ENVIRONMENT=development
